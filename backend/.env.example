PORT=3000
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria

# Modo demonstração: recria o banco a cada inicialização com dados fictícios
# e bloqueia ações sensíveis (troca de senha, uploads, cadastros etc.)
DEMO_MODE=false
# Credenciais da demo (opcional, estes são os padrões)
# DEMO_EMAIL=demo@agendamente.com.br
# DEMO_PASSWORD=demo1234
# DEMO_SUPER_EMAIL=admin@agendamente.com.br
# DEMO_SUPER_PASSWORD=admin1234

# Senha do Super Admin padrão (dono@agendamente.com) no modo normal.
# Se vazio, uma senha aleatória é gerada e exibida uma vez no log.
SUPER_ADMIN_PASSWORD=

# Banco de dados: sqlite (padrão) ou postgres
DB_TYPE=sqlite
DB_PATH=./database.sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_NAME=agendamento
DB_SSL=false

# Evolution API (WhatsApp multi-instância)
# Deixe vazio para rodar em modo de simulação (mensagens no console)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
SERVER_URL=http://localhost:3000

# Mercado Pago (opcional)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=

# SMTP para envio de e-mails (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
